{
  "name": "mordinals-ledger",
  "version": "0.3.0",
  "private": true,
  "description": "Ownership index, rules, reader and relay for Mordinals on Monero: claim, move and trade by signature, without spending the inscribed coin.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test rules/tests/rules.test.mjs reader/tests/reader.test.mjs",
    "test:views": "node --test reader/tests/views.test.mjs",
    "test:lab": "node --test rules/tests/lab.test.mjs rules/tests/lab-wallet-apps.test.mjs reader/tests/lab.test.mjs",
    "build:views": "node reader/views/build.mjs",
    "demo": "node reader/tests/demo.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.56.1"
  }
}
